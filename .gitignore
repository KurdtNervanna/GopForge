# Never commit ROM dumps — they contain your machine's serial / NVRAM.
*.rom
*.bin
*.fd
*.sha256

# Injector / tools you download yourself
tools/
DXEInject
EnableGop.ffs
EnableGop.efi

# Build artifacts (generated by build-app.command from the sources here)
GopForge.app/
AppIcon.icns
*.iconset/

# OS cruft
.DS_Store
Thumbs.db
